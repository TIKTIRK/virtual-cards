# Скопируйте этот файл в .env и впишите свои значения
DATABASE_URL=postgresql+psycopg://postgres:ПАРОЛЬ@localhost:5432/virtual_cards
CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET=СЛУЧАЙНАЯ_СТРОКА_МИНИМУМ_32_СИМВОЛА
ACCESS_TOKEN_MINUTES=60

# Кука сессии. Локально (localhost -> localhost) оставьте как есть.
# На боевом стенде (сайт на Vercel, API на другом домене по HTTPS):
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
COOKIE_NAME=session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax