# Скопируйте в .env.local и поменяйте при необходимости.

# true  — вход и регистрация работают на заглушке в браузере (бэкенд не нужен)
# false — запросы уходят на реальный бэкенд
VITE_USE_MOCK=true

VITE_API_URL=http://localhost:8000

# Нужен если VITE_API_URL=/api
VITE_PROXY_TARGET=http://localhost:8000
